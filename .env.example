NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# This file is the hosted/default config used by `npm run dev`.
# Keep your hosted Supabase URL, publishable/anon key, and service role key here.
#
# Local Docker development does not read these hosted values.
# `.\dev.ps1` generates `.env.docker` from the running local Supabase stack,
# and `docker compose up` reads that Docker-only file instead.
